package InterviewPrep;

import java.util.Arrays;

public class StringNumberBifurcate {

	public static void bifurcateString() {
		String str = "75698463210125!&%ASi,.Pp";
		char[] strNumArr = new char[str.length()];
		char[] strArr = new char[str.length()];
		int j = 0;
		int k = 0;

		// Bifurcate the string into alphabets/symbols and numbers
		for (int i = 0; i < str.length(); i++) {
			char c = str.charAt(i);
			if (String.valueOf(c).matches("[A-Za-z!&%,.]")) {
				strArr[j] = c;
				j++;
			} else if (String.valueOf(c).matches("[0-9]")) {
				strNumArr[k] = c;
				k++;
			}
		}

		// Print the characters stored in strArr
		for (int i = 0; i < j; i++) {
			System.out.print(strArr[i] + " ");
		}
		System.out.println();

		// Sort and reverse the numbers stored in strNumArr
		Arrays.sort(strNumArr, 0, k ); // Only sort the valid portion
		StringBuilder reverseStr = new StringBuilder(new String(strNumArr, 0, k));
		reverseStr.reverse();

		// Build the final result
		StringBuilder result = new StringBuilder();

		for (int i = 0; i < j; i++) { // Append non-null characters from strArr
			result.append(strArr[i]);
		}
		result.append(reverseStr); // Append reversed numbers

		// Print the final result
		System.out.println(result.toString());
	}

	public static void main(String[] args) {
		bifurcateString();
	}
}
