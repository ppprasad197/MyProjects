package InterviewPrep;

import java.util.Arrays;

public class StringNumberBifurcate {

	public static void bifurcateString() {
		String str = "75698463210125!&%ASi,.Pp";

		StringBuilder strRegAlpha = new StringBuilder();
		StringBuilder strNumArr = new StringBuilder();

		for (int i = 0; i < str.length(); i++) {
			char c = str.charAt(i);

			if (String.valueOf(c).matches("[A-Za-z!&%,.]")) {
				strRegAlpha.append(c);
			} else if (Character.isDigit(c)) {
				strNumArr.append(c);
			}
		}

		for (char c : strArr) {
			System.out.print(c + " ");
		}
		System.out.println();

		StringBuilder reverseString = new StringBuilder(strNumArr.toString());
		String revStr = reverseString.reverse().toString();

		System.out.println(revStr);

	}

	public static void main(String[] args) {
		bifurcateString();
	}
}
